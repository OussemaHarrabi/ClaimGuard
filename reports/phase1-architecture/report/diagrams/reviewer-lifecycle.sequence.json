  "cards": [
    {"dot": "emerald", "title": "Authority", "items": ["The deterministic engine creates every status", "Exactly 15 results leave the engine", "Model wording is downstream of the result"]},
    {"dot": "violet", "title": "History", "items": ["Run and results persist together", "Reviewer decisions append with an audit event", "Recheck creates version + 1 rather than overwriting"]},
    {"dot": "rose", "title": "Boundaries", "items": ["Tenant and actor come from the session", "Assistant output is verified or replaced", "No path submits to a payer"]}
