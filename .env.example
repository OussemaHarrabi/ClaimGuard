# ===========================================================================
# ClaimGuard AI — environment template
#
# Copy to `.env` and adjust:
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# `.env` is gitignored; only this template is committed. Never put real
# credentials here. Defaults that are safe for local development are baked
# into docker-compose.yml as well, so `docker compose up` works with a
# minimal `.env`.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL — used by the `db` service and by local API runs (migrations,
# audit log). DATABASE_URL is the SQLAlchemy 2.0 connection string the
# application uses (psycopg3 driver).
# ---------------------------------------------------------------------------
POSTGRES_USER=claimguard
POSTGRES_PASSWORD=claimguard
POSTGRES_DB=claimguard
DATABASE_URL=postgresql+psycopg://claimguard:claimguard@localhost:5432/claimguard

# ---------------------------------------------------------------------------
# LLM — Pydantic AI provider.
#   none      = rule-only mode (offline demo / default; no API key needed)
#   openai    = OpenAI-compatible APIs
#   anthropic = Anthropic Claude
#   ollama    = local Ollama (offline demo)
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Observability — OpenTelemetry OTLP/HTTP exporter. The endpoint below is the
# `otel-lgtm` Grafana + Loki + Mimir + Tempo stack (see docker-compose.yml).
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=claimguard

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Temporal — optional durable workflows. Start the stack explicitly with
# `docker compose --profile temporal up -d`; TEMPORAL_ENABLED=false keeps the
# app running without it.
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_ENABLED=false