# ===========================================================================
# ClaimGuard AI — environment template
#
# Copy to `.env` and adjust:
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# `.env` is gitignored; only this template is committed. Never put a real
# credential in either file: every default below is a local development
# placeholder. `docker compose up` works with a minimal `.env` because
# docker-compose.yml supplies its own container-side overrides.
#
# TWO NAMING CONVENTIONS, AND ONLY ONE OF THEM IS THE APPLICATION'S
# -----------------------------------------------------------------------
# * `CLAIMGUARD_*` are the settings the application reads. claimguard/config.py
#   is a pydantic-settings model with env_prefix="CLAIMGUARD_", so the
#   unprefixed spelling of a setting is NOT read: `DATABASE_URL` does not
#   configure the application, `CLAIMGUARD_DATABASE_URL` does. Each variable
#   below says who reads it.
# * `POSTGRES_*` are read by docker-compose.yml to create the database.
#
# The `CLAIMGUARD_*` variables the application does NOT read are grouped at the
# bottom under a heading that says so; they are declared fields of Settings, not
# working features. Do not read a variable here as evidence of a capability.
# ===========================================================================


# ---------------------------------------------------------------------------
# Database
#
# POSTGRES_*: read by the `db` service in docker-compose.yml. Not read by the
# application — they only create the role and database that the DSN below
# authenticates as.
# ---------------------------------------------------------------------------
POSTGRES_USER=claimguard
POSTGRES_PASSWORD=claimguard
POSTGRES_DB=claimguard

# CLAIMGUARD_DATABASE_URL: THE DSN. Read by claimguard.config.database_url,
# and from there by the review API, the Alembic environment and
# `claimguard status`. Host `localhost` is correct for host-side runs;
# docker-compose.yml overrides it with `db` inside the api container.
# The superuser `postgres` account is deliberately not used.
CLAIMGUARD_DATABASE_URL=postgresql+psycopg://claimguard:claimguard@localhost:5432/claimguard

# DATABASE_URL: the Alembic fallback, read by claimguard/db/migrations/env.py
# ONLY when the `claimguard` package cannot be imported. It is also the second
# choice of the review tests. Keep it in step with the DSN above.
DATABASE_URL=postgresql+psycopg://claimguard:claimguard@localhost:5432/claimguard


# ---------------------------------------------------------------------------
# Rule catalogue
#
# The engine and the API load the mentor pack's catalogue (R001-R015) from one
# of these, in this order of precedence:
#   CLAIMGUARD_RULES_DIR  the catalogue directory itself
#   CLAIMGUARD_PACK_ROOT  the pack root; `rules/` is appended
#   (neither)             a search for the pack beside the repository root
#
# The delivered pack is gitignored reference material, so a fresh clone has
# none. To run without it, point CLAIMGUARD_RULES_DIR at the vendored copy:
#   CLAIMGUARD_RULES_DIR=tests/edu/fixtures/pack_reference
# Leaving both empty is safe: an empty value is treated as unset.
# ---------------------------------------------------------------------------
CLAIMGUARD_RULES_DIR=
CLAIMGUARD_PACK_ROOT=


# ---------------------------------------------------------------------------
# Bounded SLM copilot (model-first; deterministic fail-closed twin)
#
# A reviewer-facing explanation may be written by an OpenAI-compatible
# chat-completions endpoint. The SLM drafts explanations and correction
# recommendations; the security envelope verifies them before display. The
# preserved 2026-09-25 run predates this five-field contract and selected no
# model, so MODEL and BASE_URL remain operator-supplied until the v2 rerun.
# A model can never set a rule status, severity or routing: its output is
# verified against the findings, and a failure falls back.
# ---------------------------------------------------------------------------
CLAIMGUARD_EXPLAIN_MODE=model
CLAIMGUARD_EXPLAIN_BASE_URL=
CLAIMGUARD_EXPLAIN_MODEL=
CLAIMGUARD_EXPLAIN_API_KEY=
CLAIMGUARD_EXPLAIN_TIMEOUT=20
CLAIMGUARD_EXPLAIN_MAX_TOKENS=400


# ---------------------------------------------------------------------------
# Advisory JEV judge (optional — off until a key exists; see docs/17)
#
# A second opinion that runs AFTER the deterministic engine, using TypeSafe's
# Jev ("System One") model: typed probabilistic decisions (a probability, a
# named choice, a position on an ordered scale), never generated text. It asks
# three bounded questions per finding — is the explanation grounded in the cited
# evidence, does a second opinion agree with the rule's status, how much human
# attention does this deserve — and writes its own sidecar keyed by
# (claim_id, rule_id).
#
# It is ADVISORY ONLY. Nothing it produces is ever merged into the graded 15-key
# result record, and the mentor's scorer does not see this layer at all. With
# CLAIMGUARD_TYPESAFE_API_KEY unset the judge is disabled: `claimguard judge
# assess` records every assessment as skipped and makes no request whatsoever.
#
# When the key arrives:
#   1. CLAIMGUARD_TYPESAFE_API_KEY=<the key>
#   2. uv run claimguard judge probe     # proves access, lists the real model names
#   3. CLAIMGUARD_JEV_MODEL=<a name the probe listed>
#
# Jev is in early access, so jev-latest is a default we have not verified against
# the live service; the probe is what replaces it with a name that exists.
# ---------------------------------------------------------------------------
CLAIMGUARD_TYPESAFE_API_KEY=
CLAIMGUARD_TYPESAFE_BASE_URL=https://api.typesafe.ai
CLAIMGUARD_JEV_MODEL=jev-latest
CLAIMGUARD_JEV_TIMEOUT_SECONDS=30


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# CLAIMGUARD_LOG_LEVEL: read by `claimguard serve` as uvicorn's log level.
CLAIMGUARD_LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Observability — optional OpenTelemetry (OFF by default)
#
# P1 wires spans and HTTP metrics through the OpenTelemetry SDK, but nothing is
# registered, exported or measured until CLAIMGUARD_OPS_OTEL_ENABLED is truthy
# (1/true/yes/on, case-insensitive). With it off the application imports no
# exporter, opens no socket and adds no middleware.
#
# READ BY CLAIMGUARD (claimguard/ops/telemetry.py):
#   CLAIMGUARD_OPS_OTEL_ENABLED  master switch; anything but 1/true/yes/on = off
#   CLAIMGUARD_OTEL_ENDPOINT     OTLP/HTTP base endpoint (used for spans + metrics)
#   CLAIMGUARD_OTEL_SERVICE_NAME resource.service.name on every signal
#
# The endpoint below is host-local for a host-side run. Inside Docker Compose the
# api container must reach the collector by its service name instead:
#   CLAIMGUARD_OTEL_ENDPOINT=http://otel-lgtm:4318
# Telemetry is fail-open: a dead collector or a bad endpoint is logged at most,
# never raised into a request.
# ---------------------------------------------------------------------------
CLAIMGUARD_OPS_OTEL_ENABLED=false
CLAIMGUARD_OTEL_ENDPOINT=http://localhost:4318
CLAIMGUARD_OTEL_SERVICE_NAME=claimguard


# ---------------------------------------------------------------------------
# Observability — P2 operations console sources
#
# The Technical Reviewer console (GET /v1/operations/*) shows platform health
# without opening Grafana/Prometheus/Tempo. The backend is the ONLY client of
# those systems: these URLs are read server-side, never shipped to the browser,
# and the backend sends them no credentials.
#
# READ BY CLAIMGUARD (claimguard/ops/operations.py, via claimguard/config.py):
#   CLAIMGUARD_OPS_METRICS_URL           Prometheus HTTP API base (host-local)
#   CLAIMGUARD_OPS_TRACES_URL            Tempo HTTP API base (host-local)
#   CLAIMGUARD_OPS_SOURCE_TIMEOUT_SECONDS short timeout; a down source degrades
#                                        the endpoint, it never raises a 500
#   CLAIMGUARD_OPS_STREAM_INTERVAL_SECONDS  how often the WebSocket stream
#                                        (WS /v1/operations/stream) re-fingerprints
#                                        a payload before sending a changed one;
#                                        ~3s balances freshness against source load
#
# Inside Docker Compose the api container reaches the collector by its service
# name, on the ports docker-compose.yml exposes:
#   CLAIMGUARD_OPS_METRICS_URL=http://otel-lgtm:9090
#   CLAIMGUARD_OPS_TRACES_URL=http://otel-lgtm:3200
# ---------------------------------------------------------------------------
CLAIMGUARD_OPS_METRICS_URL=http://localhost:9090
CLAIMGUARD_OPS_TRACES_URL=http://localhost:3200
CLAIMGUARD_OPS_SOURCE_TIMEOUT_SECONDS=2.0
CLAIMGUARD_OPS_STREAM_INTERVAL_SECONDS=3.0


# ---------------------------------------------------------------------------
# Declared but NOT read by any code path
#
# These are real fields of claimguard.config.Settings, so the environment does
# set them — but nothing in this repository consumes them today. They are
# listed so this template is complete and so nobody mistakes the old
# `LLM_PROVIDER` spelling for a live setting.
# ---------------------------------------------------------------------------
# No code selects an LLM provider; the explanation seam above is the only model path.
CLAIMGUARD_LLM_PROVIDER=none
CLAIMGUARD_LLM_MODEL=
CLAIMGUARD_LLM_API_KEY=
CLAIMGUARD_LLM_TEMPERATURE=0.0
# No code reads the environment name.
CLAIMGUARD_ENVIRONMENT=development
# The Temporal workflow module exists, but no code reads these to enable it.
CLAIMGUARD_TEMPORAL_ADDRESS=localhost:7233
CLAIMGUARD_TEMPORAL_ENABLED=false


# ---------------------------------------------------------------------------
# Next.js reviewer cockpit (frontend/) — the primary interface.
#
# CLAIMGUARD_API_ORIGIN is read PER REQUEST by the cockpit's /v1 proxy
# (frontend/src/app/v1/[...path]/route.ts), so it is a plain runtime setting:
# export it before `npm run dev` / `npm run start`, or pass it to the container
# with `-e`. Changing it never requires a rebuild.
#
#   cd frontend && CLAIMGUARD_API_ORIGIN=http://127.0.0.1:8030 npm run start
#
# If it is unset the proxy targets http://127.0.0.1:8000, and a wrong address is
# reported in the interface ("The review API at <origin> is unreachable") rather
# than showing an empty queue.
# ---------------------------------------------------------------------------
# Where the cockpit proxies /v1/* to. Must be an origin the FRONTEND SERVER can
# reach; with Docker Compose that is the service name (http://api:8000).
CLAIMGUARD_API_ORIGIN=http://127.0.0.1:8000
# "true" serves a bundled demo workspace with no API call at all — useful for a
# visual walkthrough, never for a live demonstration. Inlined into the browser
# bundle at BUILD time, so it must be set when building.
NEXT_PUBLIC_DEMO_MODE=false
# Direct WebSocket URL for the operations console live stream. Next.js's HTTP
# proxy route cannot carry a WebSocket upgrade, so the browser connects to the
# API origin directly. On localhost this is same-site, so the SameSite=Strict
# session cookie is still sent. A real deployment should put a reverse proxy
# (nginx, traefik, etc.) in front of both services and route the upgrade.
# The value is upgraded from ws: to wss: automatically when the page is served
# over HTTPS.
NEXT_PUBLIC_OPS_STREAM_URL=ws://127.0.0.1:8000/v1/operations/stream
# Required for signed clinic sessions. Generate a different random value for
# each deployment, at least 32 bytes. Never commit the actual value.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAIMGUARD_SESSION_KEY=
